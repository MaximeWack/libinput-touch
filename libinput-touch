PROGNAME = Path(sys.argv[0]).stem
DEVICEPREFIX = PROGNAME + " virtual"

def lock():
    'Create a lockfile'
    user = os.getlogin()
    fp = Path('/tmp', PROGNAME + '-' + user + '.lock').open('w')

    try:
        lockf(fp, LOCK_EX | LOCK_NB)
    except IOError:
        sys.exit(f'\033[91m{PROGNAME} is already running for {user}, exiting…\033[0m')

    return fp

def listen_libinput():
    'Run libinput debug-events and listen to its output'
    # User needs to belong to the input group to access the device ('sudo gpasswd -a $USER input') then log out/in
    return subprocess.Popen(shlex.split(f'stdbuf -oL -- libinput debug-events'),
                            stdout = subprocess.PIPE,
                            bufsize = 1,
                            universal_newlines = True)

def get_options():
    'Parse the command-line options'
    opt = ArgumentParser(description = __doc__)
    opt.add_argument('-c',
                     '--conffile',
                     help = 'alternative configuration file')
    opt.add_argument('-v',
                     '--verbose',
                     action = 'store_true',
                     help = 'output diagnostic messages')
    opt.add_argument('-d',
                     '--debug',
                     action = 'store_true',
                     help = 'output diagnostic messages only, do not action gestures')
    opt.add_argument('-r',
                     '--raw',
                     action = 'store_true',
                     help = 'output raw libinput output')
    for option, params in options.available.items():
        opt.add_argument('--' + option,
                         help = params['help'])
    args = opt.parse_args()

    args.verbose = args.verbose or args.debug

    return args

def verbose(message):
    if args.verbose and message:
        print(message)

def debug(message):
    if args.debug and message:
        print(f'\033[93m{message}\033[0m', file = sys.stderr)

def raw(message):
    if args.raw and message:
        print(f'\033[95m{message}\033[0m')

class OPTIONS:
    'Singleton class for storing options'

    # Configurable options with their default values and validation functions
    available = dict(
        swipe_min_threshold    = dict(default =  10, valid = float, help = 'Minimum travel distance to register a swipe'),
        ratio_min_threshold    = dict(default =  .5, valid = float, help = 'Minimum ratio to register a pinch'),
        angle_min_threshold    = dict(default =  50, valid = float, help = 'Minimum angle to register a rotation'),
        hold_min_threshold     = dict(default =  .5, valid = float, help = 'Minimum time (in s) to register a hold'),
        touch_finger_tolerance = dict(default =  .1, valid = float, help = 'Time before registering finger number change'),
        touch_multiplier       = dict(default =   4, valid = float, help = 'Multiplication factor for touchscreen gestures'),
        update_timer           = dict(default =  .1, valid = float, help = 'Time interval at which update a continuous motion'),
        devpath                = dict(default = '/dev/input', valid = str, help = 'System device path'))

    def __init__(self):
        'Create attributes from the dict and set default values'
        for opt, params in self.available.items():
            setattr(self, opt, params['default'])

    def set(self, option, value):
        'Set an option value (arg > conf > default)'
        arg = getattr(args, option)
        valid = self.available[option]['valid']

        if arg:
            try:
                setattr(self, option, valid(arg))
            except:
                return f'Option {option} must be of type {valid.__name__}. Falling back on default'
        else:
            try:
                setattr(self, option, valid(value))
            except:
                return f'Option {option} must be of type {valid.__name__}'

    instance = None

    def __new__(self):
        'Ensure single instance'
        if self.instance is None:
            self.instance = super().__new__(self)

        return self.instance

class ACTIONS:
    'Singleton class for storing actions'

    # Configurable actions and how to parse them
    available = dict(switch = {'toggle'   : ('tablet-mode', 'lid', 'keypad-slide'),
                               'state'    : ('on', 'off'),
                               'command'  : '.*'},
                     swipe =  {'fingers' : r'\d',
                               'motion'   : ('up', 'down', 'left', 'right'),
                               'modifier?': ('pre', 'chain', 'continuous', 'end', 'post'),
                               'command'  : r'[^\[\]]+',
                               'wclass?'   : r'\[.*\]'},
                     pinch =  {'fingers' : r'\d',
                               'motion'   : ('in', 'out'),
                               'modifier?': ('pre', 'chain', 'continuous', 'end', 'post'),
                               'command'  : r'[^\[\]]+',
                               'wclass?'   : r'\[.*\]'},
                     rotate = {'fingers' : r'\d',
                               'motion'   : ('cw', 'ccw'),
                               'modifier?': ('pre', 'chain', 'continuous', 'end', 'post'),
                               'command'  : r'[^\[\]]+',
                               'wclass?'   : r'\[.*\]'},
                     hold =   {'fingers' : r'\d',
                               'modifier?': ('pre', 'continuous', 'end'),
                               'command'  : r'[^\[\]]+',
                               'wclass?'   : r'\[.*\]'})

    conf_re = {}
    actions = {}
    parsed_actions = []

    def __init__(self):
        'Build parsing regexes from dict'
        for action, params in self.available.items():
            verbs = []
            for verb, arg in params.items():
                arg = '|'.join(arg) if type(arg).__name__ != 'str' else arg
                if verb[-1] == '?':
                    verbs.append(rf"""(?P<{verb[:-1]}>{arg})?""")
                else:
                    verbs.append(rf"""(?P<{verb}>{arg})""")
            self.conf_re[action] = re.compile(rf"""\s*""".join(verbs))

    def parse(self, restrict, hold, action, args, wclass_prefix):
        'Parse a conf line with the action regexes'
        fields = self.conf_re[action].match(args)

        if not fields:
            return f'Could not parse {action} line'

        fields = fields.groupdict()

        if action == 'switch':
            self.add_switch(**fields)
        else:
            fields['wclass'] = fields.get('wclass') and fields['wclass'][1:-1] or wclass_prefix
            self.add(restrict, hold, action, **fields)

    def add_switch(self, toggle, state, command):
        'Add a switch action'
        self.parsed_actions.append(f'switch {toggle:12} {state:3} {command}')
        self.build_path('switch', toggle, state, command = command)

    def add(self, restrict, hold, action, fingers, wclass, modifier, command, motion = 'still'):
        'Add all other actions'
        fingers = int(fingers)
        modifier = modifier or 'end'
        command = command.strip()

        self.parsed_actions.append(f'{restrict or '':7} {hold or ''}{action:6} {fingers} {motion or '':5} {modifier:10} {command:60} {wclass or '':>}')

        restrict = [restrict] if restrict else ['touch', 'gesture']

        for r in restrict:
            if hold:
                self.build_path(r, fingers, 'hold', action, motion, wclass, modifier, command = command)
                if not self.actions[r][fingers]['hold'][action].get('apps'):
                    self.actions[r][fingers]['hold'][action]['apps'] = set()

                self.actions[r][fingers]['hold'][action]['apps'].add(wclass)

                if not self.actions[r][fingers]['hold'].get('apps'):
                    self.actions[r][fingers]['hold']['apps'] = set()

                self.actions[r][fingers]['hold']['apps'].add(wclass)
            else:
                self.build_path(r, fingers, action, motion, wclass, modifier, command = command)

                if not self.actions[r][fingers][action].get('apps'):
                    self.actions[r][fingers][action]['apps'] = set()

                self.actions[r][fingers][action]['apps'].add(wclass)

    def build_path(self, *args, command):
        'Construct the actions dict object up to the given path'
        current = self.actions

        for arg in args[:-1]:
            if not current.get(arg):
                current[arg] = {}
            current = current[arg]

        current[args[-1]] = command

    def __str__(self):
        return '\n'.join(sorted(self.parsed_actions))

    instance = None

    def __new__(self):
        'Ensure single instance'
        if self.instance is None:
            self.instance = super().__new__(self)
        # Reset if re-creating
        else:
            self.conf_re = {}
            self.actions = {}
            self.parsed_actions = []

        return self.instance

class CONF_READER:
    'Singleton class for reading the configuration file'

    CONFNAME = f'{PROGNAME}.conf'
    CONFDIRS = (os.getenv('XDG_CONFIG_HOME', '~/.config'), '/etc')

    confpath = None
    confname = None

    def __init__(self):
        'Search for configuration file. Use file given as command line argument, else look for file in search dir order'
        if args.conffile:
            self.confname = Path(args.conffile)
            self.confpath = self.confname.expanduser()

            if not self.confpath.exists():
                sys.exit(f'\033[91mConf file {args.conffile} does not exist.\033[0m')
        else:
            for confdir in self.CONFDIRS:
                self.confname = Path(confdir, self.CONFNAME)
                self.confpath = self.confname.expanduser()

                if self.confpath.exists():
                    break
                else:
                    sys.exit(f'\033[91mNo {self.CONFNAME} file in {" or ".join(self.CONFDIRS)}.\033[0m')

    def read(self):
        'Read given configuration file and store internal actions etc'
        self.action_prefix = []
        self.wclass_prefix = None
        self.lastmodif = os.stat(self.confpath).st_mtime

        with self.confpath.open() as fp:
            for num, line in enumerate(fp, 1):
                line = line.expandtabs(2).rstrip()

                # comments
                line = re.sub(r'\s*#.*$', '', line)
                if not line.strip():
                    continue

                # wclass sections
                if re.match(r'^\[.*\]$', line.strip()):
                    self.wclass_prefix = line.strip()[1:-1]
                    if self.wclass_prefix == '':
                        self.wclass_prefix = None
                    continue

                errmsg = self.get_line(line)

                if errmsg:
                    sys.exit(f'\033[91mError at line {num} in file {self.confname}:\n>> {line} <<\n{errmsg}.\033[0m')

        # List out configured options and actions
        verbose('\nOPTIONS:')
        for option, params in options.available.items():
            value = getattr(options, option)
            default = params['default']
            if value != default:
                verbose(f'{option:24} {value:>5} ({default=})')
            else:
                verbose(f'{option:24} {value:>5}')

        verbose('\nACTIONS:')
        verbose(actions)

        verbose(' ')

    def get_line(self, line):
        'Process a single line of conf file'
        # Handle action prefix
        indent = (len(line) - len(line.lstrip(' '))) // 2

        if indent > len(self.action_prefix):
            return f'Wrong indentation'

        # Use the prefix up to the indentation level
        self.action_prefix = self.action_prefix[:indent]

        # Add words to the prefix
        if line[-1] == ':':
            self.action_prefix.append(line[:-1])
            return None

        key, argslist = (' '.join(self.action_prefix) + ' ' + line).split(maxsplit = 1)

        restrict = None
        hold = None

        if key == 'touch' or key == 'gesture':
            restrict = key
            key, argslist = argslist.split(maxsplit = 1)

        if key[:5] == 'hold+':
            hold = 'hold+'
            key = key[5:]

        if key in options.available:
            return options.set(key, argslist)
        elif key in actions.available:
            return actions.parse(restrict, hold, key, argslist, self.wclass_prefix)
        else:
            return f'Unavailable action/option {key}'

    def watch(self):
        global handlers, cmd

        if os.stat(self.confpath).st_mtime != self.lastmodif:
            verbose('Reloading…')

            # Reset actions
            ACTIONS()

            # Reload conf
            self.read()

            # Reset handlers and libinput
            handlers = {}
            cmd.terminate()
            cmd = listen_libinput()

    instance = None

    def __new__(self):
        'Ensure single instance'
        if self.instance is None:
            self.instance = super().__new__(self)

        return self.instance

class HANDLER:
    'Class for device handler objects'

    # Available capabilities
    cap_dict = dict(k = 'keyboard',
                    T = 'tablet',
                    t = 'touch', # in actions
                    p = 'pointer', # match to gesture too ? or disregard because we don't want simple pointers ?
                    g = 'gesture', # in actions
                    S = 'switch') # in actions

    # Parsing regexes for libinput events
    params_re = dict(
        LIBINPUT = re.compile(r""".*? (?P<device> event\d+)                  # Device
                                  \s* (?P<event> [A-Z_]+)                    # Event
                                  \s* (?:\d+)?                               # Event number within frame
                                  \s* (\+ (?: \d+\.\d+) s)?                  # Time
                                  \s* (?P<params> .*)?                       # Params""", flags = re.VERBOSE),

        DEVICE = re.compile(r"""(?P<name>.*?)                                # Device name
                                \s* (?P<seat>seat\d \s default)              # Seat
                                \s* (?P<group>group\d+)                      # Group
                                \s* (cap:(?P<capabilities>[kpgStT]+))        # Capabilities
                                \s* (size \s (?P<sizex>\d+) x (?P<sizey>\d+) mm)? """, flags = re.VERBOSE),

        SWITCH = re.compile(r"""switch
                                \s+ (?P<switch> tablet-mode | lid | keypad-slide) # Switch name
                                \s* state \s+ (?P<state> 0 | 1)                   # State """, flags = re.VERBOSE),

        TOUCH = re.compile(r"""(?P<finger> \d)?                                   # Finger
                            \s* \( (?: \d) \)?
                            \s* ((?: \d+\.\d+) /\s* (?: \d+\.\d+))?               # Absolute position 0-100% of width/height
                            \s* (\( \s* (?P<x> \d+\.\d+) /\s* (?P<y> \d+\.\d+) mm\))? # Absolute position in mm""", flags = re.VERBOSE),

        GESTURE = re.compile(r"""(?P<fingers> \d)                                                  # Fingers
                                \s* (?P<cancelled>cancelled)?
                                \s* ((?P<x> -? \d+\.\d+) \s* / \s* (?P<y> -? \d+\.\d+))?                                # Absolute position 0-100% of width/height
                                \s* ( \( \s* (?P<x2> -? \d+\.\d+) \s* / \s* (?P<y2> -? \d+\.\d+) \s* unaccelerated\) )? # Absolute position 0-100% of width/height
                                \s* ((?P<ratio> \d+\.\d+) \s* @ \s* (?P<angle> -? \d+\.\d+))? """, flags = re.VERBOSE),

        POINTER = re.compile(r"""((?P<x> -? \d+\.\d+) \s* / \s* (?P<y> -? \d+\.\d+))?
                                (BTN_(?P<button> LEFT | MIDDLE | RIGHT) \s \( \d+ \) \s (?P<state> pressed | released))?
                                (vert \s ((?P<vert> -?\d+\.\d+) / 0\.0 \*?) \s horiz \s ((?P<horiz> -?\d+\.\d+) / 0\.0 \*?))? """, flags = re.VERBOSE))

    def __init__(self, device):
        'Initialize a device handler'
        self.device = device
        self.LISTENERS = dict(DEVICE  = self.listener_device,
                              TOUCH   = self.listener_touch,
                              GESTURE = self.listener_gesture,
                              SWITCH  = self.listener_switch,
                              POINTER = self.listener_pointer)
        self.state = set()

        self.evdevice = libevdev.Device(open(Path(options.devpath, device), 'rb'))

        # Touch state
        self.num_slots = self.evdevice.num_slots
        if self.num_slots:
            self.fingers = 0
            self.fingers_ = 0
            self.startPos = [(0,0)] * self.num_slots
            self.prevPos = [(0,0)] * self.num_slots
            self.lastPos = [(0,0)] * self.num_slots
            self.rotation = 1

        # Get resolution for absolute position devices (touch and gesture)
        if self.evdevice.has(libevdev.ABS_X):
            self.resolution = self.evdevice.absinfo[libevdev.ABS_X].resolution
        else:
            self.resolution = 1

    def add(self, name, capabilities, sizex, sizey):
        'Populate handler parameters and disable if none of its capabilities is used in configured actions'
        self.name = name
        self.capabilities = {v for k, v in self.cap_dict.items() if k in capabilities}
        self.size = (sizex, sizey)

        self.state = set()
        if self.capabilities.isdisjoint(actions.actions) or name.startswith(DEVICEPREFIX):
            self.state.add('disabled')

        # Create a gesture translation device for touchscreens
        if 'touch' in self.capabilities and not 'disabled' in self.state:
            self.translate_device = VIRTUAL_TRANSLATE(self)

        verbose(f'{'Ignoring' if 'disabled' in self.state else 'Adding   '} device {name:50} ({self.device}) {self.capabilities}')

    def remove(self):
        'Remove the handler for an unplugged device'
        del(handlers[self.device])
        verbose(f'Removing device  {self.name:50} ({self.device})')

    def grab(self, *items):
        'Grab a handler and reset it, set the focused window class, and filter the reachable actions'
        self.reset()
        self.actions = {k:v for k, v in actions.actions.items() if k in self.capabilities}
        self.available_actions = []

        self.state = {'busy'}
        if Xlib.display:
            wm_class = Xlib.display.Display().get_input_focus().focus.get_wm_class()
            if wm_class:
                _, self.wclass = wm_class
            else:
                self.wclass = None
        else:
            self.wclass = None

        for item in items:
           self.actions = self.actions.get(item)
           if not self.actions:
               return False

        return True

    def release(self, message = None):
        'Release a handler'
        self.state = set()
        verbose(message)

    def reset(self):
        'Reset a handler gesture progression'
        self.data = dict(x = 0, y = 0, dx = 0, dy = 0, ratio = 0, dratio = 0, angle = 0, dangle = 0)
        self.start_time = monotonic()
        self.last_time = self.start_time
        self.available_gestures = []
        self.available_motions = []
        self.gesture = None
        self.motion = None

    def run(self, command):
        'Run the given command with replacement of {}'
        data = {k: floor(v) if v < 0 else ceil(v) for k, v in self.data.items()}
        exprs = re.findall(r'\{[^\{\}]+\}', command)
        for expr in exprs:
            command = command.replace(expr, str(eval(expr[1:-1], {}, data)))

        verbose(f'\033[1m\033[92m  {command}\033[0m {data}')

        if not args.debug:
            if command[0] == '_':
                command, *keys = command[1:].split()
                match command:
                    case 'keys':
                        vkey.send_keys(keys)
                    case 'begin_gesture':
                        vpad.begin_gesture()
                    case 'end_gesture':
                        vpad.end_gesture()
                    case 'scroll':
                        vpad.scroll(self.data['dx'], self.data['dy'])
                    case 'translate':
                        if self.translate_device:
                            self.translate_device.gesture()
            else:
                subprocess.Popen(shlex.split(command))

    def switch(self, switch, state):
        'Handle a switch action'
        if self.state:
            debug(f'Handler for device {self.device} is in use (shouldn\'t be possible!)')
        elif self.grab('switch', switch, state):
            self.run(self.actions)

        self.release()

    def begin(self, device_type, time, fingers):
        'Handle begin event'
        # Only grab handler if not in a hold+ gesture
        if not 'holding' in self.state:
            if self.state:
                debug(f'Handler for device {self.device} is busy (shouldn\'t be possible!)')
            elif not self.grab(device_type, fingers):
                self.release(f'No gesture action with {fingers} fingers. Releasing handler')

    def update(self, time, x, y, ratio, angle):
        'Handle update event'
        if not self.state:
            return verbose('Not listening to update events for this gesture')

        # Update handler data
        if ratio:
            ratio = log(float(ratio))
            angle = float(angle)
            self.data['dratio'] = ratio - self.data['dratio']
            self.data['ratio'] = ratio
            self.data['dangle'] += angle
            self.data['angle'] += angle

        if x:
            self.data['x'] += x
            self.data['dx'] += x
            self.data['y'] += y
            self.data['dy'] += y

        x, y, dx, dy, ratio, dratio, angle, dangle = self.data.values()

        # Get available gestures
        if not self.available_gestures:
            self.available_gestures = {k for k, v in self.actions.items() if k != 'apps' and not {self.wclass, None}.isdisjoint(v.get('apps') or set())}

        # Determine gesture
        if not self.gesture:
            self.gesture = 'rotate' if 'rotate' in self.available_gestures and abs(angle) > options.angle_min_threshold \
                     else  'pinch'  if 'pinch'  in self.available_gestures and abs(ratio) > options.ratio_min_threshold \
                     else  'swipe'  if 'swipe'  in self.available_gestures and sqrt(x ** 2 + y ** 2) > options.swipe_min_threshold \
                     else  'hold'   if 'hold'   in self.available_gestures and time - self.start_time > options.hold_min_threshold \
                else None

        # Get available motions
        if self.gesture and not self.available_motions:
            res = self.actions[self.gesture]
            self.available_motions = {k for k, v in res.items() if (not {self.wclass, None}.isdisjoint(list(v)) and k != 'apps')}

        # Determine motion
        if not self.motion:
            self.motion = 'up'    if 'up'    in self.available_motions and abs(y) > abs(x) and y < 0 \
                     else 'down'  if 'down'  in self.available_motions and abs(y) > abs(x) and y > 0 \
                     else 'left'  if 'left'  in self.available_motions and abs(x) > abs(y) and x < 0 \
                     else 'right' if 'right' in self.available_motions and abs(x) > abs(y) and x > 0 \
                     else 'in'    if 'in'    in self.available_motions and ratio < 0 \
                     else 'out'   if 'out'   in self.available_motions and ratio > 0 \
                     else 'cw'    if 'cw'    in self.available_motions and angle > 0 \
                     else 'ccw'   if 'ccw'   in self.available_motions and angle < 0 \
                     else 'still' if 'still' in self.available_motions \
                     else None

        # Register motion only if over threshold
        if 'chain' in self.state and \
            ((self.gesture == 'swipe'  and sqrt(x ** 2 + y ** 2) < options.swipe_min_threshold) or \
             (self.gesture == 'pinch'  and abs(ratio) < options.ratio_min_threshold) or \
             (self.gesture == 'rotate' and abs(angle) < options.angle_min_threshold)):
            self.motion = None

        # Get available actions
        if self.motion:
            res = self.actions[self.gesture][self.motion]
            self.available_actions = res[self.wclass] if self.wclass in res else res[None]
            if not 'continuous' in self.state:
                self.data = dict(x = 0, y = 0, dx = 0, dy = 0, ratio = 0, dratio = 0, angle = 0, dangle = 0)

        # Reset motion if only end action to mimic legacy behavior
        if list(self.available_actions) == ['end']:
            self.motion = None

        # Discard non chaining motions when chaining
        if 'chain' in self.state and 'chain' not in self.available_actions:
            self.motion = None
            self.available_actions = []
            return

        # Execute pre action only once
        if 'pre' in self.available_actions and not 'pre' in self.state:
            self.run(self.available_actions['pre'])
            self.state.add('pre')

        # Execute continuous action every timer tick and reset time and delta data
        if 'continuous' in self.available_actions and time - self.start_time > options.update_timer:
            self.run(self.available_actions['continuous'])
            self.start_time = time
            self.data['dx'] = 0
            self.data['dy'] = 0
            self.data['dangle'] = 0
            self.data['dratio'] = 0
            self.state.add('continuous')

        # Execute chain action and reset prior to determining motion
        if 'chain' in self.available_actions and self.motion:
            self.run(self.available_actions['chain'])
            self.state.add('chain')
            self.motion = None
            self.data = dict(x = 0, y = 0, dx = 0, dy = 0, ratio = 0, dratio = 0, angle = 0, dangle = 0)

        # Set holding if holding still
        if not 'holding' in self.state and self.gesture == 'hold':
            self.state.add('holding')
            self.actions = self.actions['hold']
            self.reset()

    def end(self, cancelled):
        'Handle end event'
        if not self.state:
            return verbose(f'Skipping end for device {self.device} as there isn\'t anything to do with it')

        # going from 3 holding without moving to 4 swipe does 3 hold+swipe
        if 'holding' in self.state:
            if list(self.actions) == ['still', 'apps']:
                return self.release(f'No hold+ action. Releasing handler')

            if not self.gesture and cancelled:
                return

        if not self.gesture and 'hold' in self.available_gestures:
            self.release(f'Hold too short')

        if 'end' in self.available_actions and not cancelled:
            self.run(self.available_actions['end'])

        if 'post' in self.available_actions:
            self.run(self.available_actions['post'])

        self.release()

    def parse(self, event, params):
        'Parse a libinput line and dispatch to the relevant listener'
        event = event.split('_')

        # Skip the event if the device is disabled, not supported, or empty
        if 'disabled' in self.state or not self.params_re.get(event[0]) or not params:
            return

        fields = self.params_re[event[0]].match(params)

        if not fields:
            return debug(f'Error parsing event {event[0]} params: {params}')

        fields = fields.groupdict()

        raw(f'Parsed event: {fields}')

        # Dispatch to the relevant listener
        answer = self.LISTENERS[event[0]](event[1:], monotonic(), **fields)

    def listener_device(self, event, time, name, seat, group, capabilities, sizex, sizey):
        'Listener for DEVICE lines'
        match event[0]:
            case 'ADDED'  : self.add(name, capabilities, sizex, sizey)
            case 'REMOVED': self.remove()
            case _        : debug(f'Device event {event} not recognized')

    def listener_switch(self, event, time, switch, state):
        'Listener for SWITCH lines'
        match event[0]:
            case 'TOGGLE': self.switch(switch, state = 'on' if state == '1' else 'off')
            case _       : debug(f'Device event {event} not recognized')

    def listener_gesture(self, event, time, fingers, x, y, x2, y2, ratio, angle, cancelled):
        'Listener for GESTURE lines'
        match event[1]:
            case 'BEGIN' : self.begin('gesture', time, int(fingers))
            case 'UPDATE': self.update(time, float(x2) / self.resolution, float(y2) / self.resolution, ratio, angle)
            case 'END'   : self.end(cancelled)
            case _       : debug(f'Device event {event} not recognized')

    def listener_pointer(self, event, time, x, y, button, state, vert, horiz):
        'Listener for POINTER lines'
        if event[0] == 'SCROLL' and event[1] == 'FINGER':
            if not self.state:
                self.begin('gesture', time, 2)

            if self.state and vert == '0.00' and horiz == '0.00':
                self.end(False)
            else:
                self.update(time, float(horiz) / self.resolution, float(vert) / self.resolution, None, None)

        # BUTTON -> ignore? -> comment regex out so that it is not picked up ?
        # BUTTON : button pressed/released

        # MOTION -> swipe handler 1 / rotate handler 1
        # MOTION : x/y : begin if not state, can't know when end
        # x = x and float(x)
        # y = y and float(y)

    def listener_touch(self, event, time, finger, x, y):
        'Listener for TOUCH lines'
        finger = int(finger)
        x = x and float(x) / options.touch_multiplier
        y = y and float(y) / options.touch_multiplier

        def center(points):
            center = [0, 0]
            n = 0

            for point in points:
                if point != (0, 0):
                    center[0] += point[0]
                    center[1] += point[1]
                    n += 1

            return (center[0] / n, center[1] / n)

        def diff(point1, point2):
            return((point2[0] - point1[0], point2[1] - point1[1]))

        def mean_dist(points, center):
            dist = 0
            n = 0

            for point in points:
                if point != (0,0):
                    vec = diff(center, point)
                    dist += sqrt(vec[0]**2 + vec[1]**2)
                    n += 1

            return dist / n

        def norm_cross_prod(x1, y1, x2, y2):
            return (x1 * y2 - x2 * y1) / (0.0000001 + sqrt(x1 ** 2 + y1 ** 2) * sqrt(x2 ** 2 + y2 ** 2))

        def calc_angle(startPos, lastPos, startCenter, lastCenter):
            angle = 0
            xc1, yc1 = startCenter
            xc2, yc2 = lastCenter
            n = 0

            for i in range(self.num_slots):
                if startPos[i] != (0, 0):
                    x1, y1 = startPos[i]
                    x2, y2 = lastPos[i]
                    angle += asin(norm_cross_prod(x1 - xc1, y1 - yc1, x2 - xc2, y2 - yc2))
                    n += 1

            return angle / n

        if self.fingers_ > 0:
            startCenter = center(self.startPos)
            prevCenter = center(self.prevPos)
            lastCenter = center(self.lastPos)

            xrel, yrel = diff(prevCenter, lastCenter)

            xrel /= self.fingers_
            yrel /= self.fingers_

            ratio = 1
            angle = 0
            if self.fingers_ > 1:
                ratio = mean_dist(self.lastPos, lastCenter) / mean_dist(self.startPos, startCenter)
                angle = calc_angle(self.prevPos, self.lastPos, prevCenter, lastCenter) / pi * 180
        else:
            xrel = None
            yrel = None
            ratio = None
            angle = None

        match event[0]:
            case 'DOWN':
                self.fingers_ += 1
                self.finger_time = monotonic()

                self.startPos[finger] = (x, y)
                self.prevPos[finger] = (x, y)
                self.lastPos[finger] = (x, y)

            case 'UP':
                self.fingers_ -= 1
                self.finger_time = monotonic()

                self.startPos[finger] = (0, 0)
                self.prevPos[finger] = (0, 0)
                self.lastPos[finger] = (0, 0)

            case 'MOTION':
                if self.fingers > 0:
                    self.prevPos[finger] = self.lastPos[finger]
                    self.lastPos[finger] = (x, y)
                    match self.rotation:
                        case 8: #Xlib.ext.randr.Rotate_270:
                            tmp = xrel
                            xrel = yrel
                            yrel = -tmp
                        case 2: #Xlib.ext.randr.Rotate_90:
                            tmp = yrel
                            yrel = xrel
                            xrel = -tmp
                        case 4: #Xlib.ext.randr.Rotate_180:
                            xrel = -xrel
                            yrel = -yrel

                    self.update(time, xrel, yrel, ratio, angle)

        if self.fingers_ == 0:
            self.end(False)
            self.fingers = 0

        if monotonic() - self.finger_time > options.touch_finger_tolerance:
            if self.fingers != self.fingers_:
                # If #finger change, cancel
                if self.fingers != 0:
                    self.end(True)
                # If start of touch gesture, get the screen rotation
                elif Xlib.display:
                    self.rotation = Xlib.display.Display().screen().root.xrandr_get_screen_info().rotation

                self.begin('touch', time, self.fingers_)

                self.fingers = self.fingers_

class VIRTUAL_TRANSLATE:
    'Virtual device to translate touch events to gesture events'

    tool = ['BTN_TOOL_NONE',
            libevdev.BTN_TOOL_FINGER,
            libevdev.BTN_TOOL_DOUBLETAP,
            libevdev.BTN_TOOL_TRIPLETAP,
            libevdev.BTN_TOOL_QUADTAP,
            libevdev.BTN_TOOL_QUINTTAP]

    def __init__(self, parent_handler):
        'Create a virtual device with absinfo from touchscreen'

        self.parent_handler = parent_handler
        self.copy_device = parent_handler.evdevice
        self.num_slots = self.copy_device.num_slots

        dev = libevdev.Device()
        dev2 = libevdev.Device()
        dev.name = DEVICEPREFIX + " translate"
        dev2.name = DEVICEPREFIX + " motion"

        for evbit in [libevdev.INPUT_PROP_POINTER,
                      libevdev.INPUT_PROP_BUTTONPAD,
                      libevdev.BTN_LEFT,
                      libevdev.BTN_TOUCH,
                      libevdev.BTN_TOOL_FINGER,
                      libevdev.BTN_TOOL_QUINTTAP,
                      libevdev.BTN_TOOL_DOUBLETAP,
                      libevdev.BTN_TOOL_TRIPLETAP,
                      libevdev.BTN_TOOL_QUADTAP]:
            dev.enable(evbit)

        dev2.enable(libevdev.INPUT_PROP_DIRECT)
        dev2.enable(libevdev.BTN_TOUCH)

        for a in [libevdev.ABS_X,
                  libevdev.ABS_Y,
                  libevdev.ABS_MT_SLOT,
                  libevdev.ABS_MT_POSITION_X,
                  libevdev.ABS_MT_POSITION_Y,
                  libevdev.ABS_MT_TRACKING_ID]:
            dev.enable(a, self.copy_device.absinfo[a])
            dev2.enable(a, self.copy_device.absinfo[a])

        dev.enable(libevdev.ABS_MT_TOOL_TYPE, libevdev.InputAbsInfo(maximum = 2))

        self.dev = dev.create_uinput_device()
        self.dev2 = dev2.create_uinput_device()

    def flush(self):
        'Flush the evdev queue and get the fingers tracking ids at the same time'
        tracking_ids = [-1] * self.num_slots

        # Set descriptor as non-blocking to flush queued events
        fcntl(self.copy_device.fd, F_SETFL, os.O_NONBLOCK)

        try:
            for e in self.copy_device.events():
                if e.type != libevdev.SYN_DROPPED:
                    for i in range(self.num_slots):
                        tracking_ids[i] = self.copy_device.slots[i][libevdev.ABS_MT_TRACKING_ID]

        # If dropped event, sync the device (and discard the queued synced events)
        except libevdev.device.EventsDroppedException:
            for e in self.copy_device.sync():
                for i in range(self.num_slots):
                    tracking_ids[i] = self.copy_device.slots[i][libevdev.ABS_MT_TRACKING_ID]

        fcntl(self.copy_device.fd, F_SETFL, os.O_ASYNC)

        return(tracking_ids)

    def start_gesture(self, tracking_ids, tracked_fingers):
        'Initiate the gesture with the specified number of fingers'
        o = []

        for i in range(self.num_slots):
            if tracking_ids[i] != -1:
                o.extend([libevdev.InputEvent(libevdev.ABS_MT_SLOT, i),
                          libevdev.InputEvent(libevdev.ABS_MT_TRACKING_ID, tracking_ids[i])])

        o.extend([libevdev.InputEvent(libevdev.BTN_TOUCH, 1),
                  libevdev.InputEvent(self.tool[tracked_fingers], 1),
                  libevdev.InputEvent(libevdev.SYN_REPORT, 0)])

        self.dev.send_events(o)

    def translate_events(self, tracking_ids, tracked_fingers):
        'Just translate the position events and discard the rest. Break out if finger change'

        self.start_gesture(tracking_ids, tracked_fingers)

        for e in self.copy_device.events():
            if e.code == libevdev.ABS_MT_TRACKING_ID:
                break
            else:
                self.dev.send_events([e])
                self.dev2.send_events([libevdev.InputEvent(libevdev.ABS_MT_TRACKING_ID, 1),
                                       libevdev.InputEvent(libevdev.ABS_MT_POSITION_X, int(self.parent_handler.startPos[0][0] * options.touch_multiplier * self.parent_handler.resolution)),
                                       libevdev.InputEvent(libevdev.ABS_MT_POSITION_Y, int(self.parent_handler.startPos[0][1] * options.touch_multiplier * self.parent_handler.resolution)),
                                       libevdev.InputEvent(libevdev.BTN_TOUCH, 1),
                                       libevdev.InputEvent(libevdev.SYN_REPORT, 0)])
                self.dev2.send_events([libevdev.InputEvent(libevdev.ABS_MT_TRACKING_ID, -1),
                                       libevdev.InputEvent(libevdev.BTN_TOUCH, 0),
                                       libevdev.InputEvent(libevdev.SYN_REPORT, 0)])

        self.end_gesture(tracking_ids, tracked_fingers)

    def end_gesture(self, tracking_ids, tracked_fingers):
        'End the gesture'
        o = []

        for i in range(self.num_slots):
            if tracking_ids[i] != -1:
                o.extend([libevdev.InputEvent(libevdev.ABS_MT_SLOT, i),
                          libevdev.InputEvent(libevdev.ABS_MT_TRACKING_ID, -1)])

        o.extend([libevdev.InputEvent(libevdev.BTN_TOUCH, 0),
                  libevdev.InputEvent(self.tool[tracked_fingers], 0),
                  libevdev.InputEvent(libevdev.SYN_REPORT, 0)])

        self.dev.send_events(o)

    def gesture(self):
        'Reroute events to a gesture capable virtual device and cancel motions'

        # Flush the event queue and get the fingers tracking ids
        tracking_ids = self.flush()
        tracked_fingers = self.num_slots - tracking_ids.count(-1)

        # If #fingers has changed while starting the translation, cancel
        if tracked_fingers != self.parent_handler.fingers:
            return verbose("Cancelled translation")

        self.translate_events(tracking_ids, tracked_fingers)

class VIRTUAL_PAD:
    'Virtual device to send simulated gesture events'

    def __init__(self):
        'Create a virtual gesture device'

        dev = libevdev.Device()
        dev.name = DEVICEPREFIX + " gesture"

        INPUT = [libevdev.INPUT_PROP_POINTER,
                 libevdev.INPUT_PROP_BUTTONPAD]

        for i in INPUT:
            dev.enable(i)

        BTN = [libevdev.BTN_LEFT,
               libevdev.BTN_TOUCH,
               libevdev.BTN_TOOL_FINGER,
               libevdev.BTN_TOOL_QUINTTAP,
               libevdev.BTN_TOOL_DOUBLETAP,
               libevdev.BTN_TOOL_TRIPLETAP,
               libevdev.BTN_TOOL_QUADTAP]

        for b in BTN:
            dev.enable(b)

        dev.enable(libevdev.ABS_MT_TOOL_TYPE, libevdev.InputAbsInfo(maximum = 2))

        dev.enable(libevdev.ABS_X, libevdev.InputAbsInfo(maximum = 1000, resolution = 10))
        dev.enable(libevdev.ABS_Y, libevdev.InputAbsInfo(maximum = 1000, resolution = 10))
        dev.enable(libevdev.ABS_MT_SLOT, libevdev.InputAbsInfo(maximum = 4))
        dev.enable(libevdev.ABS_MT_POSITION_X, libevdev.InputAbsInfo(maximum = 1000, resolution = 10))
        dev.enable(libevdev.ABS_MT_POSITION_Y, libevdev.InputAbsInfo(maximum = 1000, resolution = 10))
        dev.enable(libevdev.ABS_MT_TRACKING_ID, libevdev.InputAbsInfo(maximum = 65535))

        self.dev = dev.create_uinput_device()

    def begin_gesture(self):
        'Set up a gesture by crossing the HOLD limit and centering the fingers'

        self.x = 490
        self.y = 490

        self.dev.send_events([libevdev.InputEvent(libevdev.ABS_MT_SLOT, 0),
                              libevdev.InputEvent(libevdev.ABS_MT_TRACKING_ID, 1),
                              libevdev.InputEvent(libevdev.ABS_MT_POSITION_X, self.x),
                              libevdev.InputEvent(libevdev.ABS_MT_POSITION_Y, self.y - 50),
                              libevdev.InputEvent(libevdev.ABS_MT_SLOT, 1),
                              libevdev.InputEvent(libevdev.ABS_MT_TRACKING_ID, 2),
                              libevdev.InputEvent(libevdev.ABS_MT_POSITION_X, self.x),
                              libevdev.InputEvent(libevdev.ABS_MT_POSITION_Y, self.y + 50),
                              libevdev.InputEvent(libevdev.BTN_TOUCH, 1),
                              libevdev.InputEvent(libevdev.BTN_TOOL_DOUBLETAP, 1),
                              libevdev.InputEvent(libevdev.SYN_REPORT, 0)])

        sleep(.04) # HOLD BEGIN (needs 40ms)

        # minimum distance to end HOLD is 14 (so sqrt(10² + 10²))
        self.x += 10
        self.y += 10
        # we end up at the center of the virtual device ready to start a gesture

        self.dev.send_events([libevdev.InputEvent(libevdev.ABS_MT_SLOT, 0),
                              libevdev.InputEvent(libevdev.ABS_MT_POSITION_X, self.x),
                              libevdev.InputEvent(libevdev.ABS_MT_POSITION_Y, self.y - 50),
                              libevdev.InputEvent(libevdev.ABS_MT_SLOT, 1),
                              libevdev.InputEvent(libevdev.ABS_MT_POSITION_X, self.x),
                              libevdev.InputEvent(libevdev.ABS_MT_POSITION_Y, self.y + 50),
                              libevdev.InputEvent(libevdev.SYN_REPORT, 0)])

        sleep(.003) # HOLD END (needs minimum distance)

    def scroll(self, x, y):
        'Send a scroll event'

        self.x += int(float(x) * 10)# / options.touch_multiplier)
        self.y += int(float(y) * 10)# / options.touch_multiplier)

        self.dev.send_events([libevdev.InputEvent(libevdev.ABS_MT_SLOT, 0),
                                libevdev.InputEvent(libevdev.ABS_MT_POSITION_X, self.x),
                                libevdev.InputEvent(libevdev.ABS_MT_POSITION_Y, self.y - 50),
                                libevdev.InputEvent(libevdev.ABS_MT_SLOT, 1),
                                libevdev.InputEvent(libevdev.ABS_MT_POSITION_X, self.x),
                                libevdev.InputEvent(libevdev.ABS_MT_POSITION_Y, self.y + 50),
                                libevdev.InputEvent(libevdev.SYN_REPORT, 0)])

    def end_gesture(self, evdevice):
        'End a gesture by lifting the fingers'

        self.dev.send_events([libevdev.InputEvent(libevdev.ABS_MT_SLOT, 0),
                              libevdev.InputEvent(libevdev.ABS_MT_TRACKING_ID, -1),
                              libevdev.InputEvent(libevdev.ABS_MT_SLOT, 1),
                              libevdev.InputEvent(libevdev.ABS_MT_TRACKING_ID, -1),
                              libevdev.InputEvent(libevdev.BTN_TOUCH, 0),
                              libevdev.InputEvent(libevdev.BTN_TOOL_DOUBLETAP, 0),
                              libevdev.InputEvent(libevdev.SYN_REPORT, 0)])

class VIRTUAL_KEY:
    'Virtual device to send simulated key events'

    def __init__(self):
        'Create a virtual keyboard device'

        dev = libevdev.Device()
        dev.name = DEVICEPREFIX + " key"

        for k in libevdev.EV_KEY.codes:
            dev.enable(k)

        self.dev = dev.create_uinput_device()

    def send_keys(self, keys):
        'Send the combination of given keys'

        ev_keys = [getattr(libevdev, 'KEY_' + k.upper()) for k in keys]
        press = [libevdev.InputEvent(ev, 1) for ev in ev_keys]
        release = [libevdev.InputEvent(ev, 0) for ev in ev_keys]

        press.append(libevdev.InputEvent(libevdev.SYN_REPORT, 0))
        release.append(libevdev.InputEvent(libevdev.SYN_REPORT, 0))

        self.dev.send_events(press)
        self.dev.send_events(release)

